{
  "manifest_version": 3,
  "name": "Atarraya",
  "description": "Pasa a Atarraya tus descargas, videos y enlaces magnet: varias conexiones, torrents y descargas que se reanudan. Gratis.",
  "version": "0.4.0",
  "key": "",
  "icons": {
    "16": "iconos/icono-16.png",
    "32": "iconos/icono-32.png",
    "48": "iconos/icono-48.png",
    "128": "iconos/icono-128.png"
  },
  "action": {
    "default_title": "Atarraya",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "iconos/icono-16.png",
      "32": "iconos/icono-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtubekids.com/*",
        "*://*.googlevideo.com/*",
        "*://youtube.googleapis.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.hulu.com/*",
        "*://tv.apple.com/*",
        "*://music.apple.com/*",
        "*://*.paramountplus.com/*",
        "*://*.peacocktv.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.starplus.com/*",
        "*://*.vix.com/*",
        "*://*.clarovideo.com/*",
        "*://*.spotify.com/*",
        "*://*.deezer.com/*",
        "*://*.tidal.com/*",
        "*://*.dazn.com/*",
        "*://*.mubi.com/*",
        "*://globoplay.globo.com/*",
        "*://*.blim.com/*"
      ],
      "js": ["medios.js", "videos.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtubekids.com/*",
        "*://*.googlevideo.com/*",
        "*://youtube.googleapis.com/*",
        "*://*.netflix.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.hulu.com/*",
        "*://tv.apple.com/*",
        "*://music.apple.com/*",
        "*://*.paramountplus.com/*",
        "*://*.peacocktv.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.starplus.com/*",
        "*://*.vix.com/*",
        "*://*.clarovideo.com/*",
        "*://*.spotify.com/*",
        "*://*.deezer.com/*",
        "*://*.tidal.com/*",
        "*://*.dazn.com/*",
        "*://*.mubi.com/*",
        "*://globoplay.globo.com/*",
        "*://*.blim.com/*"
      ],
      "js": ["esperas.js", "cola.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "cookies", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116"
}
