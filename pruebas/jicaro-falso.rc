#include <winver.h>

// La versión de Jícaro que acepta «--contrasena-stdin»
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "FileDescription",  "Jicaro falso para las pruebas de Atarraya"
            VALUE "FileVersion",      "0.2.0"
            VALUE "OriginalFilename", "Jicaro.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
