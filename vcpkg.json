{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "atarraya",
  "version-string": "0.2.1",
  "dependencies": [
    {
      "name": "wxwidgets",
      "default-features": false
    },
    {
      "name": "curl",
      "default-features": false,
      "features": [ "ssl" ]
    },
    "nlohmann-json"
  ],
  "default-features": [ "torrents" ],
